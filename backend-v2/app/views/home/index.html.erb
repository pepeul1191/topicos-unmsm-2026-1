          <i class="fa fa-car me-2"></i>Gestión de Vehículos
        </a>
        <a href="/etl" class="btn btn-lg px-4 rounded-pill" style="background-color: #c0a92b; color: #000; border-color: #c0a92b;">
          <i class="fa fa-cogs me-2"></i>Proceso de ETL
        </a>
        <a href="/websocket/docs" class="btn btn-outline-secondary btn-lg px-4 rounded-pill">
          <i class="fa fa-plug me-2"></i>WebSocket API
        </a>
      </div>
    </div>

  </div>

</main>