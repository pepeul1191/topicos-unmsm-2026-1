<main class="main-content">
  <div class="container-fluid">

    <h3 class="mb-4">
      <a href="/cars/<%= @car_id %>/edit">
        <i class="fa fa-arrow-left me-2"></i>Volver al Carro
      </a>
      / Nueva Queja
    </h3>

    <%= render 'partials/flash_messages' %>

    <div class="card mb-4">
      <div class="card-header">
        <h6 class="mb-0">
          <i class="fa fa-plus me-2"></i>
          Nueva Queja del Vehículo
        </h6>
      </div>

      <div class="card-body">

        <form action="/cars/<%= @car_id %>/complains" method="POST">

          <input type="hidden" name="authenticity_token" value="<%= form_authenticity_token %>">
          <input type="hidden" name="car_id" value="<%= @car_id %>">

          <div class="mb-3">
            <label class="form-label">Descripción</label>
            <textarea name="description" class="form-control" rows="4" required></textarea>
          </div>

          <div class="mb-3">
            <label class="form-label">Fecha</label>
            <input type="datetime-local" name="created" class="form-control" required>
          </div>

          <button class="btn btn-success">
            <i class="fa fa-save me-2"></i>Guardar
          </button>

          <a href="/cars/<%= @car_id %>/edit" class="btn btn-warning ms-2">
            Cancelar
          </a>

        </form>

      </div>
    </div>

  </div>
</main>