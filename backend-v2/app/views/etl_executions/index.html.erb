<main class="main-content">
  <div class="container-fluid">

    <!-- CABECERA (igual a Cars) -->
    <h3 class="mb-4">
      <a href="/etl-executions">
        <i class="fa fa-database me-2"></i>Ejecuciones ETL
      </a> / Lista de Ejecuciones
    </h3>

    <!-- CARD: ACCIÓN NUEVA MIGRACIÓN -->
    <div class="card mb-4">
      <div class="card-body d-flex justify-content-between align-items-center">

        <div>
          <h6 class="mb-1">
            <i class="fa fa-play me-2"></i>
            Iniciar nueva migración ETL
          </h6>
          <small class="text-muted">
            Ejecuta el proceso de sincronización desde SQLite hacia LevelDB
          </small>
        </div>

        <form action="/etl-executions" method="POST">
          <input type="hidden" name="authenticity_token" value="<%= form_authenticity_token %>">

          <button type="submit" class="btn btn-success">
            <i class="fa fa-rocket me-2"></i>Ejecutar ETL
          </button>
        </form>

      </div>
    </div>

    <%= render 'partials/flash_messages' %>

    <!-- CARD PRINCIPAL -->
    <div class="card mb-4">
      <div class="card-header">
        <h6 class="mb-0">
          <i class="fa fa-list me-2"></i>
          Historial de Ejecuciones
        </h6>
      </div>

      <div class="card-body">

        <div class="table-responsive">
          <table class="table table-striped table-hover">

            <thead>
              <tr>
                <th>ID</th>
                <th>Descripción</th>
                <th>Estado</th>
                <th>Fecha</th>
              </tr>
            </thead>

            <tbody>
              <% if @etl_executions.any? %>
                <% @etl_executions.each do |e| %>
                  <tr>
                    <td><%= e.id %></td>
                    <td><%= e.description %></td>

                    <td>
                      <% if e.succeded %>
                        <span class="badge bg-success">SUCCESS</span>
                      <% else %>
                        <span class="badge bg-danger">FAILED</span>
                      <% end %>
                    </td>

                    <td><%= Time.parse(e.created.to_s).strftime("%Y-%m-%d %H:%M:%S") %></td>
                  </tr>
                <% end %>
              <% else %>
                <tr>
                  <td colspan="4" class="text-center">
                    No hay ejecuciones registradas.
                  </td>
                </tr>
              <% end %>
            </tbody>

          </table>
        </div>

        <!-- PAGINACIÓN -->
        <% if @pagination[:total_pages] > 1 %>
          <div class="d-flex justify-content-between align-items-center mt-3">

            <div class="text-muted">
              Página <%= @pagination[:page] %> de <%= @pagination[:total_pages] %>
              — Mostrando <%= @pagination[:start_record] %> a <%= @pagination[:end_record] %>
            </div>

            <nav>
              <ul class="pagination mb-0">

                <li class="page-item <%= 'disabled' if @pagination[:page] == 1 %>">
                  <a class="page-link" href="/etl-executions?page=1">Primero</a>
                </li>

                <li class="page-item <%= 'disabled' if @pagination[:page] == 1 %>">
                  <a class="page-link" href="/etl-executions?page=<%= @pagination[:page] - 1 %>">
                    Anterior
                  </a>
                </li>

                <li class="page-item <%= 'disabled' if @pagination[:page] == @pagination[:total_pages] %>">
                  <a class="page-link" href="/etl-executions?page=<%= @pagination[:page] + 1 %>">
                    Siguiente
                  </a>
                </li>

                <li class="page-item <%= 'disabled' if @pagination[:page] == @pagination[:total_pages] %>">
                  <a class="page-link" href="/etl-executions?page=<%= @pagination[:total_pages] %>">
                    Último
                  </a>
                </li>

              </ul>
            </nav>

          </div>
        <% end %>

      </div>
    </div>

  </div>
</main>