<main class="main-content">
  <div class="container-fluid">

    <h3>Nueva Revisión Técnica</h3>

    <form action="/cars/<%= @car_id %>/technical_reviews" method="POST">

      <input type="hidden" name="authenticity_token" value="<%= form_authenticity_token %>">
      <input type="hidden" name="car_id" value="<%= @car_id %>">

      <div class="mb-3">
        <label>Descripción</label>
        <input type="text" name="description" class="form-control" required>
      </div>

      <div class="mb-3">
        <label>Fecha</label>
        <input type="datetime-local" name="created" class="form-control" required>
      </div>

      <button class="btn btn-success">Guardar</button>
      <a href="/cars/<%= @car_id %>/edit" class="btn btn-warning">Cancelar</a>

    </form>

  </div>
</main>