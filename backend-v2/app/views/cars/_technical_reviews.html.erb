<div class="card mb-4 mt-4">
  <div class="card-header d-flex justify-content-between align-items-center">
    <h6 class="mb-0">
      <i class="fa fa-wrench me-2"></i>
      Revisiones Técnicas del Vehículo
    </h6>

    <!-- BOTÓN AGREGAR -->
    <a href="/cars/<%= @car.id %>/technical_reviews/new"
       class="btn btn-success btn-sm">
      <i class="fa fa-plus"></i> Agregar
    </a>
  </div>

  <div class="card-body">

    <div class="table-responsive">
      <table class="table table-striped table-hover">

        <thead>
          <tr>
            <th>ID</th>
            <th>Descripción</th>
            <th>Fecha</th>
            <th class="text-end">Acciones</th>
          </tr>
        </thead>

        <tbody>
          <% if @technical_reviews.any? %>
            <% @technical_reviews.each do |review| %>
              <tr>
                <td><%= review.id %></td>
                <td><%= review.description %></td>
                <td><%= review.created %></td>

                <td class="text-end">

                  <!-- EDITAR -->
                  <a href="/cars/<%= @car.id %>/technical_reviews/<%= review.id %>/edit"
                     class="btn btn-sm btn-outline-secondary me-1">
                    <i class="fa fa-edit"></i>Editar
                  </a>

                  <!-- ELIMINAR -->
                  <a href="/cars/<%= @car.id %>/technical_reviews/<%= review.id %>/delete"
                     class="btn btn-sm btn-outline-danger"
                     data-method="delete"
                     onclick="return confirm('¿Eliminar esta revisión?');">
                    <i class="fa fa-trash"></i>Eliminar
                  </a>

                </td>
              </tr>
            <% end %>
          <% else %>
            <tr>
              <td colspan="4" class="text-center">
                No hay revisiones técnicas registradas.
              </td>
            </tr>
          <% end %>
        </tbody>

        <!-- PAGINACIÓN -->
        <% if @pagination_reviews[:total_pages] > 1 %>
          <tfoot>
            <tr>
              <td colspan="4">

                <div class="d-flex justify-content-between align-items-center">

                  <div class="text-muted">
                    Página <%= @pagination_reviews[:page] %> de <%= @pagination_reviews[:total_pages] %> -
                    Mostrando <%= @pagination_reviews[:start_record] %> -
                    <%= @pagination_reviews[:end_record] %>
                  </div>

                  <nav>
                    <ul class="pagination mb-0">

                      <li class="page-item <%= 'disabled' if @pagination_reviews[:page] == 1 %>">
                        <a class="page-link"
                           href="/cars/<%= @car.id %>/edit?page=1">
                          «
                        </a>
                      </li>

                      <li class="page-item <%= 'disabled' if @pagination_reviews[:page] == 1 %>">
                        <a class="page-link"
                           href="/cars/<%= @car.id %>/edit?page=<%= @pagination_reviews[:page] - 1 %>">
                          ‹
                        </a>
                      </li>

                      <li class="page-item <%= 'disabled' if @pagination_reviews[:page] == @pagination_reviews[:total_pages] %>">
                        <a class="page-link"
                           href="/cars/<%= @car.id %>/edit?page=<%= @pagination_reviews[:page] + 1 %>">
                          ›
                        </a>
                      </li>

                      <li class="page-item <%= 'disabled' if @pagination_reviews[:page] == @pagination_reviews[:total_pages] %>">
                        <a class="page-link"
                           href="/cars/<%= @car.id %>/edit?page=<%= @pagination_reviews[:total_pages] %>">
                          »
                        </a>
                      </li>

                    </ul>
                  </nav>

                </div>

              </td>
            </tr>
          </tfoot>
        <% end %>

      </table>
    </div>

  </div>
</div>