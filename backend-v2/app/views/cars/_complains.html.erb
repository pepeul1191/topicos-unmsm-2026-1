<div class="card mb-4 mt-4">
  <div class="card-header d-flex justify-content-between align-items-center">
    <h6 class="mb-0">
      <i class="fa fa-exclamation-triangle me-2"></i>
      Denuncias del Vehículo
    </h6>

    <a href="/cars/<%= @car.id %>/complains/new"
       class="btn btn-success btn-sm">
      <i class="fa fa-plus"></i> Agregar
    </a>
  </div>

  <div class="card-body">

    <div class="table-responsive">
      <table class="table table-striped table-hover">

        <thead>
          <tr>
            <th>ID</th>
            <th>Descripción</th>
            <th>Fecha</th>
            <th class="text-end">Acciones</th>
          </tr>
        </thead>

        <tbody>
          <% if @complains.any? %>
            <% @complains.each do |c| %>
              <tr>
                <td><%= c.id %></td>
                <td><%= c.description %></td>
                <td><%= c.created %></td>

                <td class="text-end">

                  <a href="/cars/<%= @car.id %>/complains/<%= c.id %>/edit"
                     class="btn btn-sm btn-outline-secondary me-1">
                    <i class="fa fa-edit"></i> Editar
                  </a>

                  <a href="/cars/<%= @car.id %>/complains/<%= c.id %>/delete"
                     class="btn btn-sm btn-outline-danger"
                     data-method="delete"
                     onclick="return confirm('¿Eliminar esta queja?');">
                    <i class="fa fa-trash"></i> Eliminar
                  </a>

                </td>
              </tr>
            <% end %>
          <% else %>
            <tr>
              <td colspan="4" class="text-center">
                No hay quejas registradas.
              </td>
            </tr>
          <% end %>
        </tbody>

        <% if @pagination_complains[:total_pages] > 1 %>
          <tfoot>
            <tr>
              <td colspan="4">
                <div class="d-flex justify-content-between">

                  <div class="text-muted">
                    Página <%= @pagination_complains[:page] %> de <%= @pagination_complains[:total_pages] %>
                  </div>

                  <nav>
                    <ul class="pagination mb-0">
                      <li class="page-item">
                        <a class="page-link" href="/cars/<%= @car.id %>/edit?page=1">«</a>
                      </li>
                    </ul>
                  </nav>

                </div>
              </td>
            </tr>
          </tfoot>
        <% end %>

      </table>
    </div>

  </div>
</div>