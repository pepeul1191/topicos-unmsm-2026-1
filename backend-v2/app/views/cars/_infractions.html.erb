<div class="card mb-4 mt-4">
  <div class="card-header d-flex justify-content-between align-items-center">
    <h6 class="mb-0">
      <i class="fa fa-exclamation-circle me-2"></i>
      Infracciones del Vehículo
    </h6>

    <a href="/cars/<%= @car.id %>/infractions/new"
       class="btn btn-success btn-sm">
      <i class="fa fa-plus"></i> Agregar
    </a>
  </div>

  <div class="card-body">

    <div class="table-responsive">
      <table class="table table-striped table-hover">

        <thead>
          <tr>
            <th>ID</th>
            <th>Descripción</th>
            <th>Fecha</th>
            <th class="text-end">Acciones</th>
          </tr>
        </thead>

        <tbody>
          <% if @infractions.any? %>
            <% @infractions.each do |i| %>
              <tr>
                <td><%= i.id %></td>
                <td><%= i.description %></td>
                <td><%= i.created %></td>

                <td class="text-end">

                  <a href="/cars/<%= @car.id %>/infractions/<%= i.id %>/edit"
                     class="btn btn-sm btn-outline-secondary me-1">
                    <i class="fa fa-edit"></i> Editar
                  </a>

                  <a href="/cars/<%= @car.id %>/infractions/<%= i.id %>/delete"
                     class="btn btn-sm btn-outline-danger"
                     data-method="delete"
                     onclick="return confirm('¿Eliminar esta infracción?');">
                    <i class="fa fa-trash"></i> Eliminar
                  </a>

                </td>
              </tr>
            <% end %>
          <% else %>
            <tr>
              <td colspan="4" class="text-center">
                No hay infracciones registradas.
              </td>
            </tr>
          <% end %>
        </tbody>

        <% if @pagination_infractions[:total_pages] > 1 %>
          <tfoot>
            <tr>
              <td colspan="4">
                <div class="d-flex justify-content-between">

                  <div class="text-muted">
                    Página <%= @pagination_infractions[:page] %> de <%= @pagination_infractions[:total_pages] %>
                  </div>

                </div>
              </td>
            </tr>
          </tfoot>
        <% end %>

      </table>
    </div>

  </div>
</div>